.git
.gitignore
.github

# Secrets and local state
.env
.env.*
!env.example

# Dependencies, rebuilt inside the image
node_modules
vendor
.pnpm-store

# Build output and caches
.next
dist
build
out
coverage
.turbo
storage/framework
bootstrap/cache
*.log

# Throwaway proof code, never delivered (WP-E0)
proof

# Agent and workflow state, which belongs to the working copy, not to an image
.claude
.workflow
.devcontainer
.specify

# Generated at first start on the volume, never part of an image
storage/app.key
storage/*.sqlite
storage/logs
