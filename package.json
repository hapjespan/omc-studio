{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "omc-studio",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources tests/js",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "check": "node scripts/run-checks.mjs",
        "test:proof": "vitest run --config proof/wp-e0/vitest.config.ts",
        "verify": "npm run lint && npm run typecheck && npm run test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.65.1",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.11",
        "eslint": "^10.15.0",
        "eslint-plugin-vue": "^10.12.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.0.0",
        "vitest": "^5.1.1",
        "vue-tsc": "^3.3.14"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@expo-google-fonts/space-grotesk": "0.4.1",
        "@inertiajs/vue3": "^3.11.0",
        "@open-pencil/core": "0.16.0",
        "@open-pencil/scene-graph": "0.16.0",
        "@open-pencil/vue": "0.16.0",
        "canvaskit-wasm": "0.41.1",
        "html-to-image": "1.11.13",
        "reka-ui": "^2.11.0",
        "vue": "^3.5.45"
    }
}
